{
  "name": "vot-health-za",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test test/unit/*.test.js",
    "rank:saved": "node scripts/rank-saved.mjs",
    "heldout:preflight": "node scripts/heldout-preflight.mjs",
    "heldout:stats": "node scripts/heldout-stats.mjs",
    "heldout:rank": "node scripts/heldout-rank.mjs",
    "heldout:scorecard": "node scripts/heldout-scorecard.mjs",
    "score:notes": "node scripts/score-notes.mjs",
    "score:report": "node scripts/score-report.mjs",
    "score:a2": "node scripts/score-revision.mjs",
    "score:a2:report": "node scripts/score-revision-report.mjs",
    "scan:transcripts": "node scripts/scan-transcripts.mjs",
    "scan:provenance": "node scripts/scan-provenance.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fola \"node --test --test-concurrency=1 test/rules/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-fola"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
