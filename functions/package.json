{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "license": "AGPL-3.0-only",
  "scripts": {
    "serve": "node ../node_modules/firebase-tools/lib/bin/firebase.js emulators:start --only functions --project demo-fola",
    "shell": "node ../node_modules/firebase-tools/lib/bin/firebase.js functions:shell --project demo-fola",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "private": true,
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
